# Copy this file to `.env.local` and adjust for your environment.
# (Next.js loads .env.local automatically; NEXT_PUBLIC_* vars are exposed to the browser.)

# When `false`, the app makes real HTTP requests to NEXT_PUBLIC_API_BASE_URL.
# When unset or `true`, the app uses in-memory mock data (no backend needed).
NEXT_PUBLIC_USE_MOCK=true

# Root URL of the backend API (no trailing slash). Used when NEXT_PUBLIC_USE_MOCK=false.
# Example: https://api.zinder.com  or  /api  (with a dev rewrite, see next.config.mjs)
NEXT_PUBLIC_API_BASE_URL=/api
