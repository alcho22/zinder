# Copy this file to `.env` and adjust for your environment.

# When `false`, the app makes real HTTP requests to VITE_API_BASE_URL.
# When unset or `true`, the app uses in-memory mock data (no backend needed).
VITE_USE_MOCK=true

# Root URL of the backend API (no trailing slash). Used when VITE_USE_MOCK=false.
# Example: https://api.zinder.com  or  /api  (with a dev proxy, see vite.config.ts)
VITE_API_BASE_URL=/api
